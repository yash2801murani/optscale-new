# ──────────────────────────────────────────────────────────────────────────────
# OptScale Docker Compose Environment Configuration
# Copy this file to .env and fill in the required values.
# ──────────────────────────────────────────────────────────────────────────────

# ── REQUIRED ──────────────────────────────────────────────────────────────────

# The external port nginx will bind to on the host. Access the UI at http://<host>:OPTSCALE_PORT
OPTSCALE_PORT=80

# ── OPTIONAL: OAuth Integrations ──────────────────────────────────────────────

# Google OAuth (for Sign-in with Google in the UI)
GOOGLE_OAUTH_CLIENT_ID=
GOOGLE_OAUTH_CLIENT_SECRET=

# Microsoft OAuth (for Sign-in with Microsoft in the UI)
MICROSOFT_OAUTH_CLIENT_ID=

# Google Maps (for resource-location map feature)
VITE_GOOGLE_MAP_API_KEY=

# Google Analytics tracking ID
VITE_GANALYTICS_ID=

# Hotjar site ID
VITE_HOTJAR_ID=

# ── OPTIONAL: Slack Integration ───────────────────────────────────────────────
SLACK_SIGNING_SECRET=
SLACK_CLIENT_ID=
SLACK_CLIENT_SECRET=

# ── OPTIONAL: Email / SMTP ────────────────────────────────────────────────────
# SMTP_SERVER=smtp.example.com
# SMTP_PORT=465
# SMTP_EMAIL=noreply@example.com
# SMTP_LOGIN=noreply@example.com
# SMTP_PASSWORD=
# SMTP_PROTOCOL=SSL

# ── OPTIONAL: Stripe Billing ──────────────────────────────────────────────────
# STRIPE_API_KEY=
# STRIPE_WEBHOOK_SECRET=
